# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Search index
MEILISEARCH_URL=http://localhost:7700
MEILISEARCH_MASTER_KEY=replace-me

# Supabase REST (free V1 fallback)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-me

# Optional live web search fallback
# Keep this server-side only; never expose it in the frontend.
BRAVE_SEARCH_API_KEY=replace-me

# API
API_CORS_ORIGINS=http://localhost:3000

# Crawler
CRAWLER_USER_AGENT=NisaanSearchEngineBot/0.1 (+https://github.com/NissanL7/NisaanSearchEngine)
CRAWLER_REQUEST_DELAY_SECONDS=1
